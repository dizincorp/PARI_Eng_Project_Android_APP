<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header bar with Title and Close 'X' Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/btn_close_dialog"
            android:text="@string/dialog_edit_name_title"
            android:textColor="@color/brand_slate_950"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_close_dialog"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_close"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            app:tint="@color/brand_slate_400" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        android:background="@color/brand_slate_200" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_first_name"
        android:textColor="@color/brand_slate_700"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edit_first_name"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:autofillHints="personGivenName"
        android:background="@drawable/bg_input_rounded"
        android:hint="@string/hint_first_name"
        android:inputType="textPersonName|textCapWords"
        android:paddingHorizontal="14dp"
        android:textColor="@color/brand_slate_950"
        android:textColorHint="@color/brand_slate_400"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/label_last_name"
        android:textColor="@color/brand_slate_700"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edit_last_name"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:autofillHints="personFamilyName"
        android:background="@drawable/bg_input_rounded"
        android:hint="@string/hint_last_name"
        android:inputType="textPersonName|textCapWords"
        android:paddingHorizontal="14dp"
        android:textColor="@color/brand_slate_950"
        android:textColorHint="@color/brand_slate_400"
        android:textSize="14sp" />

</LinearLayout>
