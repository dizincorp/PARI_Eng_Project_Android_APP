<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header bar with Title and Close 'X' Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_rounded_indigo">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_card_vehicles"
                    app:tint="@color/brand_indigo_600" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_add_vehicle"
                    android:textColor="@color/brand_slate_950"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/subtitle_add_vehicle"
                    android:textColor="@color/brand_slate_500"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_close_dialog"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_close"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            app:tint="@color/brand_slate_400" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        android:background="@color/brand_slate_200" />

    <!-- Vehicle Make / Model Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_vehicle_make"
        android:textColor="@color/brand_slate_700"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edit_vehicle_make"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:autofillHints="none"
        android:background="@drawable/bg_input_rounded"
        android:hint="@string/hint_vehicle_make"
        android:inputType="textCapWords"
        android:paddingHorizontal="14dp"
        android:textColor="@color/brand_slate_950"
        android:textColorHint="@color/brand_slate_400"
        android:textSize="14sp" />

    <!-- Vehicle License Plate Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/label_vehicle_plate"
        android:textColor="@color/brand_slate_700"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edit_vehicle_plate"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:autofillHints="none"
        android:background="@drawable/bg_input_rounded"
        android:hint="@string/hint_vehicle_plate"
        android:inputType="textCapCharacters"
        android:paddingHorizontal="14dp"
        android:textColor="@color/brand_slate_950"
        android:textColorHint="@color/brand_slate_400"
        android:textSize="14sp" />

</LinearLayout>
