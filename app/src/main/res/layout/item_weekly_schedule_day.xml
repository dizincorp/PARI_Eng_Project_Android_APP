<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_input_rounded"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top Row: Day Name & "Cały dzień" Toggle with Checkmark -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/check_day"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:button="@drawable/selector_checkbox_checkmark"
            android:buttonTint="@null"
            android:paddingStart="8dp"
            android:textColor="@color/brand_slate_900"
            android:textSize="15sp"
            android:textStyle="bold"
            app:buttonTint="@null"
            tools:text="Poniedziałek" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/check_all_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:button="@drawable/selector_checkbox_checkmark"
            android:buttonTint="@null"
            android:paddingStart="8dp"
            android:text="@string/label_all_day_check"
            android:textColor="@color/brand_slate_700"
            android:textSize="13sp"
            app:buttonTint="@null" />
    </LinearLayout>

    <!-- Bottom Content: Closed State, All-Day Badge, or Time Pickers -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <!-- 1. Closed state badge -->
        <TextView
            android:id="@+id/text_day_closed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/badge_closed"
            android:textColor="@color/brand_slate_400"
            android:textSize="13sp"
            android:textStyle="italic" />

        <!-- 2. All Day Active badge -->
        <LinearLayout
            android:id="@+id/layout_all_day_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_badge_emerald"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_check_circle"
                app:tint="@color/brand_emerald_600" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/badge_all_day"
                android:textColor="@color/brand_emerald_700"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 3. Custom Time Pickers (Od - Do) -->
        <LinearLayout
            android:id="@+id/layout_time_pickers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="gone">

            <!-- Time From Button -->
            <LinearLayout
                android:id="@+id/btn_time_from"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_icon_rounded_slate"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_time_from"
                    android:textColor="@color/brand_slate_500"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/text_time_from"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/brand_slate_950"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="13:00" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:text="―"
                android:textColor="@color/brand_slate_400"
                android:textSize="16sp" />

            <!-- Time To Button -->
            <LinearLayout
                android:id="@+id/btn_time_to"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_icon_rounded_slate"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_time_to"
                    android:textColor="@color/brand_slate_500"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/text_time_to"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/brand_slate_950"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="20:00" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
