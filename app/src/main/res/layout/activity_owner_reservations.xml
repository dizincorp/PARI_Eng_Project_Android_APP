<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_slate_50"
    tools:context=".ui.OwnerReservationsActivity">

    <!-- Header Section -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_background"
        android:elevation="1dp"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Back Button -->
            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_rounded_slate"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/btn_close"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/brand_slate_800" />

            <!-- Title & Subtitle -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_owner_reservations"
                    android:textColor="@color/brand_slate_950"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/subtitle_owner_reservations"
                    android:textColor="@color/brand_slate_500"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Extra Filters Button -->
            <FrameLayout
                android:id="@+id/btn_owner_filters"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_icon_rounded_slate"
                android:clickable="true"
                android:contentDescription="@string/owner_filter_title"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_tune"
                    app:tint="@color/brand_slate_800" />

                <TextView
                    android:id="@+id/badge_owner_filter_count"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_badge_emerald"
                    android:gravity="center"
                    android:textColor="@color/brand_emerald_800"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="2"
                    tools:visibility="visible" />
            </FrameLayout>

            <!-- Refresh Button -->
            <ImageButton
                android:id="@+id/btn_refresh"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_rounded_slate"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/btn_refresh"
                android:src="@drawable/ic_refresh"
                app:tint="@color/brand_slate_800" />
        </LinearLayout>

        <!-- Segmented Filter Chips Row -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:overScrollMode="never"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_filters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_all"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/tab_all"
                    android:textColor="@color/chip_filter_text_selector"
                    app:chipBackgroundColor="@color/chip_filter_bg_selector"
                    app:chipCornerRadius="14dp"
                    app:chipStrokeColor="@color/chip_filter_stroke_selector"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_pending"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tab_pending"
                    android:textColor="@color/chip_filter_text_selector"
                    app:chipBackgroundColor="@color/chip_filter_bg_selector"
                    app:chipCornerRadius="14dp"
                    app:chipStrokeColor="@color/chip_filter_stroke_selector"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_confirmed"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tab_confirmed"
                    android:textColor="@color/chip_filter_text_selector"
                    app:chipBackgroundColor="@color/chip_filter_bg_selector"
                    app:chipCornerRadius="14dp"
                    app:chipStrokeColor="@color/chip_filter_stroke_selector"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_in_progress"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tab_in_progress"
                    android:textColor="@color/chip_filter_text_selector"
                    app:chipBackgroundColor="@color/chip_filter_bg_selector"
                    app:chipCornerRadius="14dp"
                    app:chipStrokeColor="@color/chip_filter_stroke_selector"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_completed"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/owner_filter_completed"
                    android:textColor="@color/chip_filter_text_selector"
                    app:chipBackgroundColor="@color/chip_filter_bg_selector"
                    app:chipCornerRadius="14dp"
                    app:chipStrokeColor="@color/chip_filter_stroke_selector"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cancelled_rejected"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/owner_filter_cancelled_rejected"
                    android:textColor="@color/chip_filter_text_selector"
                    app:chipBackgroundColor="@color/chip_filter_bg_selector"
                    app:chipCornerRadius="14dp"
                    app:chipStrokeColor="@color/chip_filter_stroke_selector"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_expired_noshow"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/owner_filter_expired_noshow"
                    android:textColor="@color/chip_filter_text_selector"
                    app:chipBackgroundColor="@color/chip_filter_bg_selector"
                    app:chipCornerRadius="14dp"
                    app:chipStrokeColor="@color/chip_filter_stroke_selector"
                    app:chipStrokeWidth="1dp" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Progress Indicator -->
    <ProgressBar
        android:id="@+id/progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/header_layout" />

    <!-- RecyclerView of Owner Reservations -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_reservations"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progress_bar"
        tools:listitem="@layout/item_owner_reservation" />

    <!-- Empty State Container -->
    <LinearLayout
        android:id="@+id/layout_empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_layout"
        tools:visibility="visible">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:alpha="0.4"
            android:contentDescription="@null"
            android:src="@drawable/ic_reservations"
            app:tint="@color/brand_slate_400" />

        <TextView
            android:id="@+id/text_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/msg_no_owner_reservations"
            android:textAlignment="center"
            android:textColor="@color/brand_slate_500"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reset_owner_filters"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="20dp"
            android:text="@string/filter_reset_btn"
            android:textAllCaps="false"
            android:textColor="@color/brand_slate_800"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:cornerRadius="12dp"
            app:strokeColor="@color/brand_slate_300" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
