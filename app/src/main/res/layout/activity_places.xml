<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_slate_50"
    tools:context=".ui.PlacesActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="24dp">

            <!-- Greeting Section -->
            <TextView
                android:id="@+id/text_greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/user_greeting"
                android:textColor="@color/brand_slate_950"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/dashboard_subtitle"
                android:textColor="@color/brand_slate_500"
                android:textSize="13sp" />

            <!-- Earnings Card (Modern White Flat Surface with Rounded Corners) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_earnings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="20dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/brand_slate_200"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:text="@string/earnings_title"
                            android:textColor="@color/brand_slate_500"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <!-- Growth Badge (Soft Emerald Pill) -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:background="@drawable/bg_badge_emerald"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp">

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:contentDescription="@string/earnings_growth"
                                android:src="@drawable/ic_arrow_up"
                                app:tint="@color/brand_emerald_700" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="@string/earnings_growth"
                                android:textColor="@color/brand_emerald_700"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/text_earnings_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/earnings_value"
                        android:textColor="@color/brand_slate_950"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <!-- Bar Chart Representation with Rounded Bars -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_marginTop="18dp"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_bar_chart_slate" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_bar_chart_slate" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_bar_chart_slate" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_bar_chart_slate" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="62dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_bar_chart_emerald" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="16dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_bar_chart_slate" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action Buttons Row (Add Spot & Availability) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add_place"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/brand_slate_950"
                    android:elevation="2dp"
                    android:text="@string/btn_add_place"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_add_location"
                    app:iconGravity="textStart"
                    app:iconSize="16dp"
                    app:iconTint="@color/brand_emerald_400" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_availability"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/card_background"
                    android:elevation="1dp"
                    android:text="@string/btn_availability"
                    android:textAllCaps="false"
                    android:textColor="@color/brand_slate_900"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_calendar"
                    app:iconGravity="textStart"
                    app:iconSize="16dp"
                    app:iconTint="@color/brand_slate_700"
                    app:strokeColor="@color/brand_slate_200"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_owner_reservations"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/card_background"
                android:elevation="1dp"
                android:text="@string/btn_owner_reservations"
                android:textAllCaps="false"
                android:textColor="@color/brand_slate_900"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_reservations"
                app:iconGravity="textStart"
                app:iconSize="16dp"
                app:iconTint="@color/brand_emerald_600"
                app:strokeColor="@color/brand_slate_200"
                app:strokeWidth="1dp" />

            <!-- Section Moje Miejsca Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="@string/my_places_title"
                    android:textColor="@color/brand_slate_950"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="@string/link_all"
                    android:textColor="@color/brand_emerald_600"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- My Places Dynamic Container -->
            <LinearLayout
                android:id="@+id/container_my_places"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?android:attr/windowBackground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>
