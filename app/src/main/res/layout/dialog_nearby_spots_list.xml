<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_background"
    android:orientation="vertical">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_bar_chart_slate" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_list_address_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/nearby_list_title"
                android:textColor="@color/brand_slate_950"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_list_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/brand_slate_500"
                android:textSize="12sp"
                tools:text="ul. Złota 12 • 6 parkingów (promień 5.0 km)" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_close_nearby_list"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_close"
            android:src="@drawable/ic_close"
            app:tint="@color/brand_slate_600" />
    </LinearLayout>

    <!-- Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_list_open_filters"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:gravity="center"
            android:includeFontPadding="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/map_filter_btn"
            android:textAllCaps="false"
            android:textColor="@color/brand_slate_900"
            android:textSize="13sp"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_tune"
            app:iconSize="16dp"
            app:iconTint="@color/brand_slate_900"
            app:strokeColor="@color/brand_slate_300" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_list_expand_radius"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:includeFontPadding="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/nearby_expand_radius_btn"
            android:textAllCaps="false"
            android:textColor="@color/brand_emerald_700"
            android:textSize="13sp"
            app:cornerRadius="10dp"
            app:strokeColor="@color/brand_emerald_300" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/brand_slate_200" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="380dp"
        android:background="@color/bg_main">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_nearby_spots_full"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp" />

        <LinearLayout
            android:id="@+id/layout_nearby_list_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/nearby_no_results_hint"
                android:textColor="@color/brand_slate_600"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
