<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_slate_50"
    tools:context=".ui.ReservationsActivity">

    <!-- Top Bar with Title, Progress Bar, and Refresh Action -->
    <LinearLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/title_reservations"
            android:textColor="@color/brand_slate_950"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progress_bar_reservations"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="12dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/brand_emerald_500"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/btn_refresh_reservations"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/btn_refresh"
            android:focusable="true"
            android:padding="7dp"
            android:src="@drawable/ic_refresh"
            app:tint="@color/brand_slate_700" />
    </LinearLayout>

    <!-- Top Segmented Toggle Tabs (Aktywne / Historia) -->
    <LinearLayout
        android:id="@+id/layout_tabs"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_segmented_container"
        android:orientation="horizontal"
        android:padding="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_top_bar">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_tab_active"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="@color/brand_slate_950"
            android:gravity="center"
            android:includeFontPadding="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="@string/tab_active"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            app:elevation="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_tab_history"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:backgroundTint="@color/brand_slate_100"
            android:gravity="center"
            android:includeFontPadding="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="@string/tab_history"
            android:textAllCaps="false"
            android:textColor="@color/brand_slate_600"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            app:elevation="0dp" />
    </LinearLayout>

    <!-- History Filters Strip (Visible strictly on Historia tab) -->
    <LinearLayout
        android:id="@+id/layout_history_filters"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_tabs"
        tools:visibility="visible">

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_history_quick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_hquick_all"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/places_filter_all"
                    android:textColor="@color/chip_filter_text_selector"
                    android:textSize="12sp"
                    app:chipBackgroundColor="@color/chip_filter_bg_selector"
                    app:chipStrokeColor="@color/chip_filter_stroke_selector"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_hquick_completed"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_completed"
                    android:textColor="@color/chip_filter_text_selector"
                    android:textSize="12sp"
                    app:chipBackgroundColor="@color/chip_filter_bg_selector"
                    app:chipStrokeColor="@color/chip_filter_stroke_selector"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_hquick_7d"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/history_filter_date_7d"
                    android:textColor="@color/chip_filter_text_selector"
                    android:textSize="12sp"
                    app:chipBackgroundColor="@color/chip_filter_bg_selector"
                    app:chipStrokeColor="@color/chip_filter_stroke_selector"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_hquick_short"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/history_filter_dur_short"
                    android:textColor="@color/chip_filter_text_selector"
                    android:textSize="12sp"
                    app:chipBackgroundColor="@color/chip_filter_bg_selector"
                    app:chipStrokeColor="@color/chip_filter_stroke_selector"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_hquick_price_desc"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/history_sort_price_desc"
                    android:textColor="@color/chip_filter_text_selector"
                    android:textSize="12sp"
                    app:chipBackgroundColor="@color/chip_filter_bg_selector"
                    app:chipStrokeColor="@color/chip_filter_stroke_selector"
                    app:chipStrokeWidth="1dp" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_history_filters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/brand_slate_200"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="7dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@string/history_filter_btn"
                    android:src="@drawable/ic_tune"
                    app:tint="@color/brand_slate_900" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="@string/history_filter_btn"
                    android:textColor="@color/brand_slate_900"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/badge_history_filter_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_badge_emerald"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:textColor="@color/brand_emerald_800"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="2"
                    tools:visibility="visible" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Empty State Layout -->
    <LinearLayout
        android:id="@+id/layout_empty_state"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingVertical="40dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_history_filters">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_icon_rounded_slate"
            android:contentDescription="@string/msg_no_active_reservation"
            android:padding="16dp"
            android:src="@drawable/ic_places"
            app:tint="@color/brand_slate_400" />

        <TextView
            android:id="@+id/text_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/title_reservations"
            android:textColor="@color/brand_slate_950"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_empty_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="@string/msg_no_active_reservation"
            android:textColor="@color/brand_slate_500"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_search_on_map"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/brand_slate_950"
            android:elevation="2dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="24dp"
            android:text="@string/btn_search_on_map"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_search"
            app:iconGravity="textStart"
            app:iconSize="16dp"
            app:iconTint="@color/brand_emerald_400" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reset_history_filters"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="20dp"
            android:text="@string/filter_reset_btn"
            android:textAllCaps="false"
            android:textColor="@color/brand_slate_800"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:cornerRadius="12dp"
            app:strokeColor="@color/brand_slate_300" />
    </LinearLayout>

    <!-- RecyclerView for Active and History Reservations List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_reservations"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingTop="6dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_history_filters"
        tools:listitem="@layout/item_reservation" />

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?android:attr/windowBackground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>
