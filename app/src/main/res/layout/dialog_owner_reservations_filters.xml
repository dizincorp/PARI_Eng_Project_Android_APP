<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_background"
    android:orientation="vertical">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_bar_chart_slate" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/owner_filter_title"
            android:textColor="@color/brand_slate_950"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_close_owner_filters"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_close"
            android:src="@drawable/ic_close"
            app:tint="@color/brand_slate_600" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/brand_slate_200" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Guest / Plate / Spot Query -->
            <EditText
                android:id="@+id/edit_owner_query"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input_rounded"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="10dp"
                android:drawableTint="@color/brand_slate_400"
                android:hint="@string/owner_filter_search_hint"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:textColor="@color/brand_slate_900"
                android:textColorHint="@color/brand_slate_400"
                android:textSize="14sp" />

            <!-- Sortowanie -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/owner_filter_sort_section"
                android:textColor="@color/brand_slate_900"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_owner_sort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_osort_start_desc"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/owner_sort_start_desc"
                    android:textColor="@color/chip_filter_text_selector"
                    app:chipBackgroundColor="@color/chip_filter_bg_selector"
                    app:chipStrokeColor="@color/chip_filter_stroke_selector"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_osort_start_asc"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/owner_sort_start_asc"
                    android:textColor="@color/chip_filter_text_selector"
                    app:chipBackgroundColor="@color/chip_filter_bg_selector"
                    app:chipStrokeColor="@color/chip_filter_stroke_selector"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_osort_price_desc"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/owner_sort_price_desc"
                    android:textColor="@color/chip_filter_text_selector"
                    app:chipBackgroundColor="@color/chip_filter_bg_selector"
                    app:chipStrokeColor="@color/chip_filter_stroke_selector"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_osort_price_asc"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/owner_sort_price_asc"
                    android:textColor="@color/chip_filter_text_selector"
                    app:chipBackgroundColor="@color/chip_filter_bg_selector"
                    app:chipStrokeColor="@color/chip_filter_stroke_selector"
                    app:chipStrokeWidth="1dp" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Miejsce parkingowe -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/owner_filter_spot_section"
                android:textColor="@color/brand_slate_900"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_owner_spots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:selectionRequired="true"
                app:singleSelection="true" />

            <!-- Okres rezerwacji -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/owner_filter_date_section"
                android:textColor="@color/brand_slate_900"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_owner_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_odate_all"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/history_filter_date_all"
                    android:textColor="@color/chip_filter_text_selector"
                    app:chipBackgroundColor="@color/chip_filter_bg_selector"
                    app:chipStrokeColor="@color/chip_filter_stroke_selector"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_odate_today"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/history_filter_date_today"
                    android:textColor="@color/chip_filter_text_selector"
                    app:chipBackgroundColor="@color/chip_filter_bg_selector"
                    app:chipStrokeColor="@color/chip_filter_stroke_selector"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_odate_upcoming"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/owner_filter_date_upcoming"
                    android:textColor="@color/chip_filter_text_selector"
                    app:chipBackgroundColor="@color/chip_filter_bg_selector"
                    app:chipStrokeColor="@color/chip_filter_stroke_selector"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_odate_7d"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/history_filter_date_7d"
                    android:textColor="@color/chip_filter_text_selector"
                    app:chipBackgroundColor="@color/chip_filter_bg_selector"
                    app:chipStrokeColor="@color/chip_filter_stroke_selector"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_odate_30d"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/history_filter_date_30d"
                    android:textColor="@color/chip_filter_text_selector"
                    app:chipBackgroundColor="@color/chip_filter_bg_selector"
                    app:chipStrokeColor="@color/chip_filter_stroke_selector"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_odate_custom"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/history_filter_date_custom"
                    android:textColor="@color/chip_filter_text_selector"
                    app:chipBackgroundColor="@color/chip_filter_bg_selector"
                    app:chipStrokeColor="@color/chip_filter_stroke_selector"
                    app:chipStrokeWidth="1dp" />
            </com.google.android.material.chip.ChipGroup>

            <LinearLayout
                android:id="@+id/layout_owner_custom_dates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_owner_date_from"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/history_filter_date_from"
                    android:textAllCaps="false"
                    android:textColor="@color/brand_slate_900"
                    android:textSize="12sp"
                    app:cornerRadius="10dp"
                    app:strokeColor="@color/brand_slate_300" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_owner_date_to"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="@string/history_filter_date_to"
                    android:textAllCaps="false"
                    android:textColor="@color/brand_slate_900"
                    android:textSize="12sp"
                    app:cornerRadius="10dp"
                    app:strokeColor="@color/brand_slate_300" />
            </LinearLayout>

            <!-- Kwota rezerwacji -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/owner_filter_price_section"
                android:textColor="@color/brand_slate_900"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/edit_owner_price_min"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_rounded"
                    android:hint="@string/map_filter_price_min"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/brand_slate_900"
                    android:textColorHint="@color/brand_slate_400"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/edit_owner_price_max"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_rounded"
                    android:hint="@string/map_filter_price_max"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/brand_slate_900"
                    android:textColorHint="@color/brand_slate_400"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/brand_slate_200" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reset_owner_dialog_filters"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:text="@string/map_filter_reset"
            android:textAllCaps="false"
            android:textColor="@color/brand_slate_700"
            app:cornerRadius="12dp"
            app:strokeColor="@color/brand_slate_300" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_apply_owner_dialog_filters"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.5"
            android:backgroundTint="@color/brand_slate_950"
            android:text="@string/filter_apply_btn"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:cornerRadius="12dp" />
    </LinearLayout>
</LinearLayout>
